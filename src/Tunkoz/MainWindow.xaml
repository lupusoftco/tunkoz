<Window x:Class="Tunkoz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tünköz - QR Code Detector"
        Width="400"
        Height="200"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Tünköz" FontSize="32" FontWeight="Bold" Foreground="#1a1a1a" TextAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="Right-click any QR code on screen" FontSize="14" Foreground="#666" TextAlignment="Center" Margin="0,0,0,16"/>

        <Border BorderThickness="1" BorderBrush="#ddd" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Status: Running" Foreground="#28a745" Margin="0,0,0,8"/>
                <TextBlock Text="Open Debug Console to see detections" Foreground="#666" FontSize="12"/>
            </StackPanel>
        </Border>

        <Button Name="DebugButton" Click="OnDebugClick" Padding="16,12" Content="Open Debug Console" Background="#007bff" Foreground="White" Margin="0,0,0,16"/>
        <Button Name="ExitButton" Click="OnExitClick" Padding="16,12" Content="Exit"/>
    </StackPanel>
</Window>
