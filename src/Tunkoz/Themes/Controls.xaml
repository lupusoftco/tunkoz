<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Metrics merged here so StaticResource lookups below always resolve at load time -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Button Styles -->
    <Style x:Key="TunkozPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Accent.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Accent.OnFill}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{StaticResource Tunkoz.Button.Padding}"/>
        <Setter Property="Height" Value="{StaticResource Tunkoz.Button.Height}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.BodyStrong}"/>
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.UI}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Tunkoz.Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TunkozSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Surface.Inset}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tunkoz.Brush.Stroke.Control}"/>
        <Setter Property="Padding" Value="{StaticResource Tunkoz.Button.Padding}"/>
        <Setter Property="Height" Value="{StaticResource Tunkoz.Button.Height}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.BodyStrong}"/>
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.UI}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Tunkoz.Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Surface.Card}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TunkozIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="{StaticResource Tunkoz.IconButton.Size}"/>
        <Setter Property="Height" Value="{StaticResource Tunkoz.IconButton.Size}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Tunkoz.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Surface.Inset}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Style -->
    <Style x:Key="TunkozCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tunkoz.Brush.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Tunkoz.Radius.Surface}"/>
        <Setter Property="Padding" Value="{StaticResource Tunkoz.Card.Padding}"/>
        <Setter Property="Effect" Value="{DynamicResource Tunkoz.Shadow.Card.Light}"/>
    </Style>

    <!-- Banner Styles -->
    <Style x:Key="TunkozInfoBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Info.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tunkoz.Brush.Info.Foreground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Tunkoz.Radius.Control}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
    </Style>

    <Style x:Key="TunkozWarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Warning.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tunkoz.Brush.Warning.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Tunkoz.Radius.Control}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
    </Style>

    <Style x:Key="TunkozDangerBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Danger.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tunkoz.Brush.Danger.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Tunkoz.Radius.Control}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
    </Style>

    <Style x:Key="TunkozSuccessBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tunkoz.Brush.Success.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tunkoz.Brush.Success.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Tunkoz.Radius.Control}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
    </Style>

    <!-- Text Styles -->
    <Style x:Key="TunkozDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.Display}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.Display}"/>
        <Setter Property="LineHeight" Value="{StaticResource Tunkoz.LineHeight.Display}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="TunkozTitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.TitleLarge}"/>
        <Setter Property="LineHeight" Value="{StaticResource Tunkoz.LineHeight.TitleLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="TunkozBodyStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.BodyStrong}"/>
        <Setter Property="LineHeight" Value="{StaticResource Tunkoz.LineHeight.BodyStrong}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="TunkozBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.Body}"/>
        <Setter Property="LineHeight" Value="{StaticResource Tunkoz.LineHeight.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="TunkozCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.Caption}"/>
        <Setter Property="LineHeight" Value="{StaticResource Tunkoz.LineHeight.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Secondary}"/>
    </Style>

    <Style x:Key="TunkozMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Tunkoz.Font.Mono}"/>
        <Setter Property="FontSize" Value="{StaticResource Tunkoz.FontSize.Mono}"/>
        <Setter Property="LineHeight" Value="{StaticResource Tunkoz.LineHeight.Mono}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
    </Style>

</ResourceDictionary>
