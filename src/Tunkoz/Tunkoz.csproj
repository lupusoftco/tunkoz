<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <UseWindowsForms Condition="'$(OS)' == 'Windows_NT'">true</UseWindowsForms>
    <DisableWindowsTargetingCheck>true</DisableWindowsTargetingCheck>
    <AssemblyName>Tunkoz</AssemblyName>
    <RootNamespace>Tunkoz</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Tünköz Contributors</Authors>
    <Description>Right-click any QR code on Windows</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lupusoftco/tunkoz</RepositoryUrl>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tunkoz.Core\Tunkoz.Core.csproj" />
  </ItemGroup>

</Project>
