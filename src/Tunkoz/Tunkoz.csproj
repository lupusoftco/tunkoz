<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <UseWindowsForms Condition="'$(OS)' == 'Windows_NT'">true</UseWindowsForms>
    <!-- Allow compilation on Linux for syntax checking, but WPF won't run there -->
    <DisableWindowsTargetingCheck>true</DisableWindowsTargetingCheck>
    <!-- For Windows builds, ensure we target WindowsDesktop SDK features -->
    <GenerateTargetFrameworkMonikerAttribute>false</GenerateTargetFrameworkMonikerAttribute>
    <AssemblyName>Tunkoz</AssemblyName>
    <RootNamespace>Tunkoz</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>Lupusoft</Authors>
    <Company>Lupusoft</Company>
    <Product>Tünköz</Product>
    <Copyright>© Lupusoft</Copyright>
    <ApplicationIcon>Assets\Tunkoz.ico</ApplicationIcon>
    <Description>Right-click any QR code on Windows</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lupusoftco/tunkoz</RepositoryUrl>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tunkoz.Core\Tunkoz.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Tunkoz.ico" />
    <Resource Include="Assets\logo-128.png" />
    <Resource Include="Assets\tray-*.ico" />
    <Resource Include="Assets\Fonts\ChakraPetch-SemiBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
