<Window x:Class="Tunkoz.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Tunkoz.Services"
        Title="{Binding [About.WindowTitle], Source={x:Static svc:Loc.Instance}}"
        Icon="pack://application:,,,/Assets/Tunkoz.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource Tunkoz.Brush.Surface.Window}"
        TextElement.Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"
        TextElement.FontFamily="{StaticResource Tunkoz.Font.UI}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <StackPanel>
        <Grid Height="32">
            <TextBlock FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                       Text="{Binding [About.WindowTitle], Source={x:Static svc:Loc.Instance}}"/>
            <Button Style="{StaticResource TunkozCaptionButton}" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnCloseClick" AutomationProperties.Name="{Binding [About.Close], Source={x:Static svc:Loc.Instance}}">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
            </Button>
        </Grid>

        <StackPanel Margin="36,28,36,28" HorizontalAlignment="Stretch">
            <Image Source="pack://application:,,,/Assets/logo-128.png" Width="88" Height="88" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Style="{StaticResource TunkozDisplayText}" Text="Tünköz" FontSize="34" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock x:Name="VersionText" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{DynamicResource Tunkoz.Brush.Text.Secondary}"/>
            <TextBlock FontSize="14" LineHeight="21" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,14,0,0"
                       HorizontalAlignment="Center" Text="{Binding [About.Story], Source={x:Static svc:Loc.Instance}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/lupusoftco/tunkoz" RequestNavigate="OnLink"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Link}">github.com/lupusoftco/tunkoz</Hyperlink>
                </TextBlock>
                <TextBlock FontSize="13" Text="·" Margin="16,0" Foreground="{DynamicResource Tunkoz.Brush.Text.Secondary}"/>
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/lupusoftco/tunkoz/blob/main/LICENSE" RequestNavigate="OnLink"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Link}">
                        <Run Text="{Binding [About.License], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource TunkozSecondaryButton}" Click="OnGitHubClick"
                        Content="{Binding [About.OpenGitHub], Source={x:Static svc:Loc.Instance}}"/>
                <Button Grid.Column="2" Style="{StaticResource TunkozPrimaryButton}" Click="OnCloseClick"
                        Content="{Binding [About.Close], Source={x:Static svc:Loc.Instance}}"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
