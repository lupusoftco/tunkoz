<Window x:Class="Tunkoz.Views.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tünköz"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="368"
        SizeToContent="Height"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- 16 px transparent margin leaves room for the drop shadow; the visible card is 336 px wide -->
    <Border x:Name="CardBorder" Margin="16" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource Tunkoz.Brush.Surface.Card}"
            BorderBrush="{DynamicResource Tunkoz.Brush.Stroke.Card}"
            Effect="{DynamicResource Tunkoz.Shadow.Card}">
        <Grid x:Name="ClipHost">
            <StackPanel Margin="16">
                <!-- Header: type tile · type label · close -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TypeTile" Width="32" Height="32" CornerRadius="6"
                            Background="{DynamicResource Tunkoz.Brush.Tile.Info.Background}">
                        <Path x:Name="TypeIcon" Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Link}"
                              TextElement.Foreground="{DynamicResource Tunkoz.Brush.Tile.Info.Foreground}"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource Tunkoz.Brush.Text.Secondary}">
                        <TextBlock x:Name="TypeLabel" Style="{StaticResource TunkozCaption}" Text="Web link"/>
                        <StackPanel x:Name="SchemePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource TunkozCaption}" Text="·" Margin="6,0"/>
                            <Path x:Name="SchemeLock" Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Lock}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SchemeText" Style="{StaticResource TunkozCaption}" Text="HTTPS"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource TunkozGhostIconButton}" Click="OnCloseClick">
                        <Path Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Close}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Title block -->
                <StackPanel Margin="0,14,0,0">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource Tunkoz.Font.UI}" FontSize="22" FontWeight="Bold"
                               LineHeight="28" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
                    <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" FontFamily="{StaticResource Tunkoz.Font.Mono}" FontSize="12"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Secondary}"/>
                    <TextBlock x:Name="BodyText" Visibility="Collapsed" Style="{StaticResource TunkozBody}" FontSize="14"
                               LineHeight="20" TextWrapping="Wrap" MaxHeight="120" TextTrimming="WordEllipsis"/>
                </StackPanel>

                <!-- Inset rows (Wi-Fi password, contact phone/email) -->
                <Border x:Name="InsetHost" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="6"
                        Background="{DynamicResource Tunkoz.Brush.Surface.Inset}">
                    <StackPanel x:Name="InsetRows"/>
                </Border>

                <!-- Warning / danger banner: always icon + title + sentence -->
                <Border x:Name="Banner" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="6" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="BannerIcon" Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Warning}"
                              VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="BannerTitle" FontFamily="{StaticResource Tunkoz.Font.UI}" FontSize="13" FontWeight="SemiBold"
                                       LineHeight="18" TextWrapping="Wrap"/>
                            <TextBlock x:Name="BannerBody" FontFamily="{StaticResource Tunkoz.Font.UI}" FontSize="13"
                                       LineHeight="18" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actions -->
                <StackPanel Margin="0,14,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource TunkozPrimaryButton}" Click="OnPrimaryClick">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PrimaryIcon" Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.OpenExternal}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PrimaryText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SecondaryButton" Style="{StaticResource TunkozSecondaryButton}" Margin="0,8,0,0" Click="OnSecondaryClick">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="SecondaryIcon" Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Copy}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SecondaryText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Auto-dismiss line: drains along the bottom edge, pauses on hover -->
            <Grid VerticalAlignment="Bottom" Height="2" Background="{DynamicResource Tunkoz.Brush.Progress.Track}">
                <Rectangle x:Name="DismissLine" Fill="{DynamicResource Tunkoz.Brush.Brand.Glow}" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="DismissScale" ScaleX="1"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </Grid>
    </Border>
</Window>
