<Window x:Class="Tunkoz.Views.DebugConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tünköz Debug Console"
        Width="800"
        Height="600"
        Background="#1e1e1e"
        Foreground="#d4d4d4">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="OutputText"
            Grid.Row="0"
            Margin="8"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            FontFamily="Consolas"
            FontSize="11"
            Foreground="#d4d4d4"/>

        <ScrollViewer Grid.Row="0" Margin="8">
            <TextBlock
                x:Name="OutputTextScroll"
                TextWrapping="Wrap"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="#d4d4d4"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8" Height="40">
            <Button Name="ClearButton" Click="OnClear" Padding="12,8" Margin="0,0,8,0" Content="Clear"/>
            <Button Name="PauseButton" Click="OnPause" Padding="12,8" Content="Pause"/>
        </StackPanel>
    </Grid>
</Window>
