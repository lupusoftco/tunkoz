<Window x:Class="Tunkoz.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Tunkoz.Services"
        Title="{Binding [Settings.WindowTitle], Source={x:Static svc:Loc.Instance}}"
        Icon="pack://application:,,,/Assets/Tunkoz.ico"
        Width="640" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource Tunkoz.Brush.Surface.Window}"
        TextElement.Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"
        TextElement.FontFamily="{StaticResource Tunkoz.Font.UI}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <StackPanel>
        <!-- Title bar -->
        <Grid Height="40">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/Tunkoz.ico" Width="16" Height="16" Margin="0,0,10,0"/>
                <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding [Settings.WindowTitle], Source={x:Static svc:Loc.Instance}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TunkozCaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize"
                        AutomationProperties.Name="Minimize">
                    <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
                </Button>
                <Button Style="{StaticResource TunkozCaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose"
                        AutomationProperties.Name="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Margin="40,12,40,40">
            <TextBlock FontSize="28" FontWeight="SemiBold" LineHeight="36" Margin="0,0,0,12"
                       Text="{Binding [Settings.Title], Source={x:Static svc:Loc.Instance}}"/>
            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8"
                       Text="{Binding [Settings.General], Source={x:Static svc:Loc.Instance}}"/>

            <!-- Language row -->
            <Border MinHeight="64" Padding="20,12" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource Tunkoz.Brush.Surface.Row}"
                    BorderBrush="{DynamicResource Tunkoz.Brush.Stroke.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Globe}" Width="20" Height="20" StrokeThickness="1.3"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="14" Text="{Binding [Settings.Language], Source={x:Static svc:Loc.Instance}}"/>
                        <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Tunkoz.Brush.Text.Secondary}"
                                   Text="{Binding [Settings.Language.Desc], Source={x:Static svc:Loc.Instance}}"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="3" Style="{StaticResource TunkozComboBox}"
                              VerticalAlignment="Center" SelectionChanged="OnLanguageChanged"
                              AutomationProperties.Name="{Binding [Settings.Language], Source={x:Static svc:Loc.Instance}}"/>
                </Grid>
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
