<Window x:Class="Tunkoz.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tünköz Settings"
        Width="500"
        Height="600"
        MinWidth="400"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Tunkoz.Brush.Surface.Base}">

    <DockPanel LastChildFill="True">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Tunkoz.Brush.Surface.Card}"
                BorderBrush="{DynamicResource Tunkoz.Brush.Stroke.Card}"
                BorderThickness="0,0,0,1"
                Padding="16">
            <TextBlock Style="{StaticResource TunkozTitleLarge}"
                       Text="Settings"
                       Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
        </Border>

        <!-- Close Button -->
        <Button DockPanel.Dock="Top"
                HorizontalAlignment="Right"
                Margin="16"
                Width="32"
                Height="32"
                Style="{StaticResource TunkozIconButton}"
                Click="OnCloseClick"
                Content="✕"
                FontSize="16"/>

        <!-- Settings Sections -->
        <ScrollViewer DockPanel.Dock="Top"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16">
            <StackPanel>
                <!-- General Section -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource TunkozBodyStrong}"
                               Text="General"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>

                    <Border Background="{DynamicResource Tunkoz.Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Tunkoz.Brush.Stroke.Card}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource TunkozBody}"
                                           Text="Theme"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="ThemeCombo"
                                          Padding="8,6,8,6">
                                    <ComboBoxItem Content="System"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Dark"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource TunkozBody}"
                                           Text="Language"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="LanguageCombo"
                                          Padding="8,6,8,6">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Türkçe"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Detection Section -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource TunkozBodyStrong}"
                               Text="Detection"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>

                    <Border Background="{DynamicResource Tunkoz.Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Tunkoz.Brush.Stroke.Card}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <StackPanel>
                            <CheckBox x:Name="FullscreenCheckBox"
                                      Content="Disable in fullscreen apps"
                                      IsChecked="True"
                                      Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"
                                      Margin="0,0,0,12"/>

                            <CheckBox x:Name="StartupCheckBox"
                                      Content="Start with Windows"
                                      Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Card Section -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource TunkozBodyStrong}"
                               Text="Card"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>

                    <Border Background="{DynamicResource Tunkoz.Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Tunkoz.Brush.Stroke.Card}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource TunkozBody}"
                                           Text="Auto-dismiss timeout (seconds)"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         x:Name="TimeoutTextBox"
                                         Text="8"
                                         Padding="8,6,8,6"
                                         TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Privacy Section -->
                <StackPanel>
                    <TextBlock Style="{StaticResource TunkozBodyStrong}"
                               Text="Privacy"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>

                    <Border Background="{DynamicResource Tunkoz.Brush.Info.Background}"
                            BorderBrush="{DynamicResource Tunkoz.Brush.Info.Foreground}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource TunkozCaption}"
                                   Text="Tünköz works entirely offline. No data is sent to any server, and no content is logged or shared."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Tunkoz.Brush.Info.Foreground}"/>
                    </Border>

                    <CheckBox x:Name="ExpandShortlinksCheckBox"
                              Content="Expand short links (sends HTTP requests to follow redirects)"
                              IsChecked="False"
                              Foreground="{DynamicResource Tunkoz.Brush.Text.Primary}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Tunkoz.Brush.Surface.Card}"
                BorderBrush="{DynamicResource Tunkoz.Brush.Stroke.Card}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Style="{StaticResource TunkozPrimaryButton}"
                        Content="Close"
                        Click="OnCloseClick"
                        Padding="16,8,16,8"
                        MinWidth="80"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
