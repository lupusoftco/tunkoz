<Window x:Class="Tunkoz.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Tunkoz.Services"
        Title="Tünköz"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="280"
        SizeToContent="Height"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Native Win 11 menu metrics: 4 px inset, 36 px rows, 8 px radius; brand only in the status header -->
    <Border Margin="16" Padding="4" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource Tunkoz.Brush.Menu.Background}"
            BorderBrush="{DynamicResource Tunkoz.Brush.Menu.Stroke}"
            Effect="{DynamicResource Tunkoz.Shadow.Menu}"
            TextElement.Foreground="{DynamicResource Tunkoz.Brush.Menu.Foreground}"
            TextElement.FontFamily="{StaticResource Tunkoz.Font.UI}"
            TextElement.FontSize="14">
        <StackPanel>
            <!-- Status header -->
            <Grid Height="44" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Path Data="{StaticResource Brand.Eye}" StrokeThickness="6"
                              Stroke="{DynamicResource Tunkoz.Brush.Menu.Foreground}"/>
                        <Rectangle Canvas.Left="25" Canvas.Top="25" Width="14" Height="14" Fill="#F5B83D"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="Tünköz" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="StatusDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                               Fill="{DynamicResource Tunkoz.Brush.Menu.Dot}"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Tunkoz.Brush.Menu.Secondary}"
                               Text="{Binding [Tray.Active], Source={x:Static svc:Loc.Instance}}"/>
                </StackPanel>
            </Grid>
            <Border Height="1" Margin="-4,0,-4,4" Background="{DynamicResource Tunkoz.Brush.Menu.Separator}"/>

            <Button x:Name="SettingsItem" Style="{StaticResource TunkozMenuItem}" Click="OnSettings">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Sliders}" StrokeThickness="1.3" Margin="0,0,12,0"/>
                    <TextBlock VerticalAlignment="Center" Text="{Binding [Tray.Settings], Source={x:Static svc:Loc.Instance}}"/>
                </StackPanel>
            </Button>

            <Border Height="1" Margin="-4,4" Background="{DynamicResource Tunkoz.Brush.Menu.Separator}"/>

            <Button Style="{StaticResource TunkozMenuItem}" Click="OnAbout">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Info}" StrokeThickness="1.3" Margin="0,0,12,0"/>
                    <TextBlock VerticalAlignment="Center" Text="{Binding [Tray.About], Source={x:Static svc:Loc.Instance}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TunkozMenuItem}" Click="OnQuit">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource TunkozIcon}" Data="{StaticResource Icon.Power}" StrokeThickness="1.4" Margin="0,0,12,0"/>
                    <TextBlock VerticalAlignment="Center" Text="{Binding [Tray.Quit], Source={x:Static svc:Loc.Instance}}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
